# Keep line endings the same on every computer, so Windows does not rewrite every file.
* text=auto eol=lf
*.bat text eol=crlf

# Never touch these: Forge's packed engine is checked against exact checksums by setup_forge.py.
forge_bundle/** binary
*.jar binary
*.xz binary
*.part* binary
*.png binary
*.jpg binary
*.gif binary
*.cmd text eol=crlf
START_HERE.txt text eol=crlf
*.wsb text eol=crlf

# The Adventure's pixel art is kept byte for byte as its packs ship it (assets/rpg/MANIFEST.sha256, Round RPG10).
assets/rpg/** binary

# Round NETLOG1d: Karl's recorded Windows output, kept byte for byte (a UTF-8 BOM and CRLF line ends, as PowerShell wrote them).
tests/fixtures/net/*.txt -text
