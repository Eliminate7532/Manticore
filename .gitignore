# What is NOT backed up: things the program makes again by itself, and things that are only yours.

# The unpacked Forge engine (about 200 MB). setup_forge.py rebuilds it from forge_bundle/.
forge_runtime/

# Card pictures and card data downloaded from Scryfall (re-downloaded when needed).
cache/

# MPC Autofill pictures you picked (patch 38) and pictures imported into a deck (patch 40): other people's art, kept on this
# computer and in the local backup zips, but not pushed to GitHub.
mpc_art/
deck_art/

# Cube drafts in progress or done (Round CD2: saves/drafts/<id>/, about 100 KB each): kept on this computer and in the local
# backup zips, but not pushed to GitHub (Round ANS1, Karl 13 Oct: "Local zip only"). The decks a draft saves (My decks) still are.
saves/drafts/

# Made every time you play.
forge_engine.log
forge_engine.prev.log
forge_engine.crashed.log
forge_engine.rewind.log
forge_engine.rewind.prev.log
session.json
crash_log.txt
crash_log.old.txt
crash_native.txt
perf_log.txt
forge_decks/
*.jsonl
backup.log

# Java's own crash reports (patch 46): written beside forge_engine.log; they hold this PC's user name, PATH and temp folder.
hs_err_pid*.log
replay_pid*.log
*.mdmp

# Overnight soak runs (tools\soak.py, Round 28b): can be large, and it's Karl's own test output.
soak_runs/

# Your window size, text size and last deck choice.
settings.json

# Python leftovers.
__pycache__/
*.pyc

# Bug reports friends send you, and the file holding your Discord webhook address (anyone with that address can post to your channel).
bug_reports/
bug_report_config.json
bug_report_config.bundled.json

# The installer build (Round 29): the built folder holds the bundled webhook, so it is never committed or pushed.
build/
dist/
installer_out/
installer/sandbox/results/
installer/sandbox/*.wsb

# Never back up passwords, tokens or keys.
.env
# Round MP1: the host's own certificate and private key for online play (made on this PC, never shared).
net/
*.p12
*.pem
*.key
id_rsa*
id_ed25519*

# Screenshots and scratch files made while testing.
shots*/
GUI_SHOTS/
*.tmp

# Where the local copies go on this computer, and whether the last backup worked (read by the table's deck-screen banner).
backup_settings.json
backup_status.json

# big one-off transfer files (2026-10-01): kept on disk, not committed or pushed
docs/incoming/ad1_rebase/

# Round PAR1: the sessions' desks (git worktrees made by tools/desk.py, one whole copy each - their work is on their own branches)
# and the board that says who is working where (one file per session). Never committed: a desk inside the folder would otherwise
# be added as an embedded repository.
.worktrees/
.sessions/

# Round HK1 (14 Oct 2026, Karl: housekeeping) - kept on this computer only:
# Deliveries land in docs/incoming/<round>/ and are applied as commits on their round's branch; once merged, a delivery's folder
# moves to ..\manticore_archive\incoming\ (beside commander_sim). They were 85% of this repository (506 of 594 MiB).
docs/incoming/*
!docs/incoming/README.md
# The last good game states (Round LAST1): rewritten during every game, removed after 3 days.
last_good/
# Captured test output and the card checker's report: made again by every run.
quick.txt
test_results.txt
r28d_test.txt
card_check_report.txt
